# Paste into the Portal app's Settings -> Secrets on Streamlit Community Cloud. NEVER commit real values.

# Used once, on the "First-time setup" screen, to create the first Super Admin.
APP_PASSWORD = "choose-a-strong-setup-password"

# Encrypts salaries, payslips, PAN and bank details. The app shows a ready-made key to the Super Admin if this
# line is missing. KEEP A COPY OFFLINE: if the key is lost, encrypted data cannot be read again.
PORTAL_ENCRYPTION_KEY = "paste-the-key-here"

[mysql]
host = "your-service.aivencloud.com"
port = 12345
database = "ciliconchip_portal"
user = "avnadmin"
password = "your-database-password"
ssl_ca = """-----BEGIN CERTIFICATE-----
...Aiven CA certificate...
-----END CERTIFICATE-----"""
